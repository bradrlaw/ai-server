diff --git a/serve/server.py b/serve/server.py
index 632d3c0..5fec892 100644
--- a/serve/server.py
+++ b/serve/server.py
@@ -6963,6 +6963,15 @@ def make_handler(svc: Service):
                 for c in chunks:
                     if c is None:
                         self.wfile.write(b": keep-alive\n\n")      # an SSE comment: clients ignore it
+                    elif c.get("usage") and c.get("timings") and c.get("choices"):
+                        # local patch (ADR-0033): llama.cpp sends the finish chunk with `timings`, then a separate
+                        # `usage` chunk with empty choices; LiteLLM drops `timings` when both share one chunk
+                        first = {k: v for k, v in c.items() if k != "usage"}
+                        first.setdefault("system_fingerprint", "strata")
+                        second = {k: v for k, v in c.items() if k not in ("choices", "timings")}
+                        second["choices"] = []
+                        for part in (first, second):
+                            self.wfile.write(b"data: " + json.dumps(part, ensure_ascii=False).encode() + b"\n\n")
                     else:
                         self.wfile.write(b"data: " + json.dumps(c, ensure_ascii=False).encode() + b"\n\n")
                     self.wfile.flush()
