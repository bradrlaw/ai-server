# Copy to server-status.env (gitignored) to enable the Open WebUI status banner.
#   install -m 600 server-status.env.example server-status.env  &&  edit  &&  restart the service
#   (mode 600: the file holds an Open WebUI admin API key)
#
# Create an admin API key in Open WebUI: Settings > Account > API Keys.
# When OWUI_API_KEY is set, the status service pushes a live banner to the top of
# the OWUI UI (visible on the blank new-chat screen, before typing).

OWUI_API_KEY=
# Optional overrides (defaults shown):
# OWUI_BANNER_URL=http://127.0.0.1:3000/api/v1/configs/banners
# OWUI_CONFIG_EXPORT_URL=http://127.0.0.1:3000/api/v1/configs/export
# OWUI_BANNER_INTERVAL=30
# OWUI_BANNER_ID=server-status
# OWUI_BANNER_TYPE=info
# OWUI_BANNER_DISMISSIBLE=false

# --- Small-model keeper -------------------------------------------------------
# Re-warm `small` on the idx0 card whenever its slot is empty (e.g. after a
# llama-swap restart, or after small-uncensored's ttl expires). Enabled by
# default; it never evicts small-uncensored while that is loaded. Defaults shown:
# SMALL_KEEPER_ENABLED=true
# SMALL_KEEP_MODEL=small
# SMALL_KEEP_ALT=small-uncensored
# SMALL_KEEPER_INTERVAL=60

# --- Host stats ---------------------------------------------------------------
# Filesystems to report disk usage for (one row each). Each item is
# "label=path=kind" (label and kind optional; bare "path" also works). kind:
#   plain  — always statvfs whatever is at path (default; e.g. Root "/").
#   mount  — auto-mounted volume; if not mounted, shown as "offline".
#   secure — on-demand LUKS mount; if not mounted, shown as "locked".
# Default reports Root, the bulk drive, and the encrypted secure volume:
# STATUS_DISK_PATHS=Root=/,Bulk=/srv/ai/storage-bulk=mount,Secure=/srv/ai/storage=secure

# --- History (dashboard sparklines) -------------------------------------------
# In-memory time series (per-GPU util/power/temp/VRAM + host CPU/RAM), served at
# /history.json and drawn as inline-SVG sparklines on the status page. No deps,
# no disk; cleared on restart. Enabled by default. Defaults shown (15s x 240 = ~1h):
# HISTORY_ENABLED=true
# HISTORY_INTERVAL=15
# HISTORY_POINTS=240

# --- Quiet hours (deep-idle window) -------------------------------------------
# At window start the daily models are unloaded and the RUNNING ComfyUI units are
# stopped, and the service records which ones, so the V100s fall out of P0 to true
# cold idle (~73 W vs ~103 W). Nothing is polled during the window: an LLM request
# still loads its model on demand, and it stays loaded until the end. At window end
# native fp16 is cleared, ONLY the ComfyUI units it stopped are restarted (on-demand
# comfyui-qwen stays off unless it was running), and the daily set is re-warmed.
#
# Requires the scoped sudoers rule so this service can stop/start ComfyUI:
#   sudo install -m 0440 -o root -g root \
#     /srv/ai/scripts/server-status-comfyui.sudoers \
#     /etc/sudoers.d/server-status-comfyui
#
# Disabled by default; set QUIET_HOURS_ENABLED=true to turn it on. Defaults shown:
# QUIET_HOURS_ENABLED=false
# QUIET_HOURS_START=02:00
# QUIET_HOURS_END=09:00
# QUIET_TZ=            # tz the window is evaluated in (e.g. America/New_York). Empty =
#                     # system local. SET THIS if the machine clock is UTC (Etc/UTC).
# QUIET_CHECK_INTERVAL=30
# QUIET_UNLOAD_MODELS=true
# QUIET_STOP_COMFYUI=true
# QUIET_COMFYUI_UNITS=comfyui-open,comfyui-secure   # server-status.service adds comfyui-qwen
# QUIET_COMFYUI_STOPPED_FILE=/srv/ai/var/status-service/quiet-comfyui-stopped
#                     # units it stopped at window start (restored at window end)
# QUIET_STOP_MANAGED=true            # also stop any running managed creative-tool
#                     # services (below) when quiet hours begins — they hold VRAM and
#                     # can OOM the LLM/ComfyUI tiers. They are NOT restarted at window
#                     # end (opt-in via the dashboard buttons).
# QUIET_SYSTEMCTL=sudo systemctl
# QUIET_WARM_ON_EXIT=coding,chat
# QUIET_WARM_ON_START=coding,chat   # warmed on service start when booted OUTSIDE the
#                     # quiet window (on_startup hook only preloads `small`). Defaults
#                     # to QUIET_WARM_ON_EXIT. Set empty to disable the boot warm.
#
# Dashboard ComfyUI start/stop buttons (POST /actions/comfyui) — reuse the same
# scoped sudoers rule as quiet hours. Set false to make the page read-only:
# STATUS_ACTIONS_ENABLED=true
#
# Managed on-demand creative-tool services shown with per-row Start/Stop buttons
# (POST /actions/service). Format: "Display Name=systemd-unit,..." where the display
# name matches the SERVICES entry. These are kept DISABLED at boot and launched from
# the dashboard. Each unit needs its own line in server-status-comfyui.sudoers.
# MANAGED_SERVICES=Fooocus=fooocus,SwarmUI=swarmui,InvokeAI=invokeai
#
# Dashboard per-GPU power-limit dropdown (GPU section, POST /actions/gpu-power).
# The chosen watts are written into gpu-fan-control.config.json, which the fan
# daemon re-reads every power_recheck_sec and applies live with `nvidia-smi -pl`
# (adjusts the cap WITHOUT interrupting running jobs). No sudo/daemon restart is
# needed — the service just rewrites the file it owns, and the change persists.
# Set false to make the GPU power column read-only. The dropdown offers
# GPU_POWER_MIN_W..GPU_POWER_MAX_W in GPU_POWER_STEP_W increments (clamped per-card):
# GPU_POWER_ACTIONS_ENABLED=true
# GPU_POWER_MIN_W=150
# GPU_POWER_MAX_W=250
# GPU_POWER_STEP_W=25
#
# GPU table "Fan" column + fan alarms (summary line, OWUI banner turns amber):
# read from the gpu-fan-control daemon's per-tick snapshot. A missing file with
# the unit inactive = "fan daemon DOWN" (shroud fans on BIOS auto).
# FAN_STATE_FILE=/run/gpu-fan-control/state.json
# FAN_UNIT=gpu-fan-control.service
#
# Dashboard sign-in + CSRF (ADR-0027). Every browser signs in with one shared
# password; set/change it as the service user (no sudo, no restart needed — it also
# signs out every existing session):
#   python3 /srv/ai/scripts/server-status-service.py --set-password
# No password file => nobody can sign in (the dashboard fails closed).
# STATUS_AUTH_FILE=/srv/ai/var/status-service/auth.json
# STATUS_SESSION_IDLE_SECS=43200     # 12 h without any request (open tabs poll every 5 s)
# STATUS_SESSION_MAX_SECS=604800     # 7 d hard cap since sign-in
# STATUS_LOGIN_MAX_FAILS=5           # failed sign-ins per source IP per window -> 429
# STATUS_LOGIN_WINDOW_SECS=900
# Sources that may READ /status.json, /history.json and the chart without signing
# in (never the page or /actions/*): the host itself + Docker containers (the Open
# WebUI status filter). Set to 127.0.0.0/8,::1/128 to require sign-in from containers:
# STATUS_TRUSTED_READ_NETS=127.0.0.0/8,::1/128,172.16.0.0/12
# Extra origins allowed to POST, only if a TLS reverse proxy ever fronts the page:
# STATUS_EXTRA_ORIGINS=https://ai.example.ts.net
