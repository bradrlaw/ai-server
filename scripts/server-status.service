[Unit]
Description=AI-server status service — aggregates llama-swap/ComfyUI/GPU state as JSON + HTML
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=brad
Group=brad
# Bind on all interfaces so bridge containers (Open WebUI) and browsers can reach it.
# Reads its upstreams (llama-swap, ComfyUI) on loopback locally.
Environment=STATUS_HOST=0.0.0.0
Environment=STATUS_PORT=9095
Environment=LLAMASWAP_URL=http://127.0.0.1:9090
Environment=COMFYUI_URLS=open=http://127.0.0.1:8188,secure=http://127.0.0.1:8189,qwen=http://127.0.0.1:8190
# Units the dashboard can Start/Stop and quiet hours stops overnight to free VRAM.
# Adding comfyui-qwen (the on-demand Qwen-Image 2.1 instance, idx1) gives it a
# per-row Start/Stop button AND lets quiet hours release its V100 context. Keep
# in sync with the argument-exact lines in server-status-comfyui.sudoers.
Environment=QUIET_COMFYUI_UNITS=comfyui-open,comfyui-secure,comfyui-qwen
Environment=CUDA_DEVICE_ORDER=PCI_BUS_ID
# Optional OWUI banner push: put OWUI_API_KEY (+ any overrides) in this local file.
# The '-' prefix makes it optional; the file is gitignored (*.env). See the
# server-status.env.example template.
EnvironmentFile=-/srv/ai/scripts/server-status.env
ExecStart=/usr/bin/python3 /srv/ai/scripts/server-status-service.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
