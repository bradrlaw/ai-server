# Scoped sudoers rule for the server-status quiet-hours (deep-idle) loop and the
# dashboard start/stop buttons.
#
# The server-status service runs as `brad` and needs passwordless sudo for EXACTLY
# these systemctl start/stop commands and nothing else:
#   * ComfyUI (comfyui-open/comfyui-secure) — stopped during quiet hours to release
#     the V100 CUDA contexts, restarted at window end; also the dashboard
#     "Start ComfyUI"/"Stop" buttons (POST /actions/comfyui).
#   * The optional creative-tool services (Fooocus/SwarmUI/InvokeAI) — NOT enabled
#     at boot; started/stopped from the per-service dashboard buttons
#     (POST /actions/service) and stopped by quiet hours if left running (they hold
#     VRAM and can OOM the LLM/ComfyUI tiers). These are controlled one unit at a
#     time, so each needs its own start+stop entry.
#
# Install (run once, as root):
#   sudo install -m 0440 -o root -g root \
#     /srv/ai/scripts/server-status-comfyui.sudoers \
#     /etc/sudoers.d/server-status-comfyui
#   sudo visudo -cf /etc/sudoers.d/server-status-comfyui   # syntax check
#
# If you change QUIET_COMFYUI_UNITS or MANAGED_SERVICES in server-status.env,
# update the unit lists below to match (order-sensitive — sudo matches the exact
# argument vector).

brad ALL=(root) NOPASSWD: /usr/bin/systemctl start comfyui-open comfyui-secure, /usr/bin/systemctl stop comfyui-open comfyui-secure
brad ALL=(root) NOPASSWD: /usr/bin/systemctl start fooocus, /usr/bin/systemctl stop fooocus
brad ALL=(root) NOPASSWD: /usr/bin/systemctl start swarmui, /usr/bin/systemctl stop swarmui
brad ALL=(root) NOPASSWD: /usr/bin/systemctl start invokeai, /usr/bin/systemctl stop invokeai
