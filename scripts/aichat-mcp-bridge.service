[Unit]
Description=aichat MCP bridge — exposes external MCP servers (comfyui-secure, ...) as llm-functions tools for aichat
Documentation=https://github.com/bradrlaw/ai-server
# The bridge reads /srv/ai/tools/llm-functions/mcp.json and connects to each MCP
# server listed there (currently the login-gated comfyui-secure MCP on :9001),
# re-exposing their tools over a small HTTP API on 127.0.0.1:8808 that the llm-functions
# bin shims (bin/comfyui_secure_*) POST to. aichat picks them up via functions.json.
#
# The bridge opens ONE session to :9001 at startup and has NO reconnect logic, so a
# restart of comfyui-mcp-secure (e.g. after a workflow-param change:
# `systemctl restart comfyui-mcp-secure`) leaves the bridge talking to a dead
# session while its process stays alive (Restart=on-failure never fires). The
# PartOf+After below make systemd restart THIS unit whenever comfyui-mcp-secure is
# restarted, re-establishing the session automatically.
#   - After=  : start/restart the bridge only once the upstream MCP is up, so the
#               startup listTools() succeeds.
#   - PartOf= : propagate the upstream's stop/restart to the bridge. Deliberately
#               tied to comfyui-mcp-secure (:9001, the bridge's actual upstream),
#               NOT comfyui-secure (:8189) — quiet hours stops/starts the latter and
#               PartOf doesn't propagate *start*, which would strand the bridge down.
#               comfyui-mcp-secure is untouched by quiet hours.
After=network-online.target comfyui-mcp-secure.service
Wants=network-online.target
PartOf=comfyui-mcp-secure.service

[Service]
Type=simple
User=brad
Group=brad
WorkingDirectory=/srv/ai/tools/llm-functions
Environment=HOME=/home/brad
Environment=MCP_BRIDGE_PORT=8808
# --- Network lockdown (ADR-0026) ---------------------------------------------------
# The bridge has no auth and holds a live session to the login-gated comfyui-secure
# MCP, so it must only ever be reachable from this host. Two layers:
#   1. bind loopback only (our llm-functions patch reads MCP_BRIDGE_HOST, default
#      127.0.0.1 — so an interactive `argc mcp start` bridge is loopback too);
#   2. in-kernel cgroup filter on every socket of this unit (and its children):
#      only localhost in or out — its sole upstream is 127.0.0.1:9001.
# If you add an MCP server to mcp.json that needs other network access (e.g. a stdio
# server that downloads via npx/uvx), extend IPAddressAllow deliberately.
# Verify: scripts/verify-mcp-lockdown.sh
Environment=MCP_BRIDGE_HOST=127.0.0.1
IPAddressAllow=localhost
IPAddressDeny=any
ExecStart=/usr/bin/node /srv/ai/tools/llm-functions/mcp/bridge/index.js /srv/ai/tools/llm-functions
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
KillMode=mixed

[Install]
WantedBy=multi-user.target
