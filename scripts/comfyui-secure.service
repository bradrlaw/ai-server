[Unit]
Description=ComfyUI (LOCKED) — password-gated generative media server on V100 #2 (idx2), :8189
Documentation=https://github.com/comfyanonymous/ComfyUI
After=network-online.target nvidia-persistenced.service
Wants=network-online.target nvidia-persistenced.service
# input/output/temp-secure are symlinks into the encrypted volume (/srv/ai/storage),
# which stays locked after every boot until `sudo scripts/storage-crypt.sh unlock`.
# Only start when it is mounted, so secure assets can never land on the unencrypted
# root disk. A Condition (not RequiresMountsFor=) makes a start while locked a quick
# "skipped" no-op: RequiresMountsFor pulled the mount into the boot transaction and
# made systemd wait 90 s for the locked disk (boot reached graphical.target at
# 1min 30s) before failing. storage-crypt.sh unlock starts this unit after mounting.
After=srv-ai-storage.mount
ConditionPathIsMountPoint=/srv/ai/storage

[Service]
Type=simple
User=brad
Group=brad
WorkingDirectory=/srv/ai/comfyui
# Deterministic GPU numbering so CUDA_VISIBLE_DEVICES maps to the same physical
# cards as nvidia-smi (idx0=Titan X stopgap, idx1/2=V100).
Environment=CUDA_DEVICE_ORDER=PCI_BUS_ID
# LOCKED instance: pin to V100 #2 (idx2 = the `chat` card) so it never contends
# for GPU with the OPEN instance (idx1). Single GPU by owner decision (ADR-0013,
# 2026-10-15 addendum); dual-V100 component placement (CUDA_VISIBLE_DEVICES=2,1 +
# --reserve-vram 2 + ComfyUI-MultiGPU loaders) is a future item — recipe in
# docs/server-setup.md "Dual-V100 for oversized ComfyUI models".
Environment=CUDA_VISIBLE_DEVICES=2
# Reduce allocator fragmentation so large activation spikes (e.g. MiniMax-H3 DiT
# attention on longer clips) can reuse reserved-but-unallocated VRAM instead of
# OOMing. See the H3 OOM analysis: 2.44 GiB alloc failed with ~2.76 GiB reserved
# but unallocated on the 32 GB V100.
Environment=PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
Environment=LLAMASWAP_URL=http://127.0.0.1:9090
# Free the idx2 occupants (chat / gemma-26b) on generate; keep everything on the
# cards this instance does NOT use — idx1 (coding, gemma-31b, chat-uncensored-q6)
# and idx0 (small, small-uncensored). Dual-card big/coder-next are intentionally
# omitted so they get freed (they occupy idx2). Keep in sync with llama-swap.yaml.
Environment=FREE_GPU_KEEP=coding,gemma-31b,chat-uncensored-q6,small,small-uncensored
Environment=FREE_GPU_IDLE_SECS=300
Environment=FREE_GPU_RESTORE=chat
# Optional per-instance extra args (currently only --fp16-unet), toggled from the
# status page. Lives on tmpfs (/run) so it AUTO-RESETS to empty on every boot —
# native fp16 never silently persists across a reboot. The leading '-' makes a
# missing file non-fatal; COMFYUI_EXTRA_ARGS then expands to nothing.
EnvironmentFile=-/run/comfyui-fp16/secure.env
# Auth: ComfyUI-Login is loaded via the extra custom_nodes path below (present
# ONLY on this instance). Set the shared password on first visit to :8189/login.
# The PASSWORD lives at /srv/ai/comfyui/login/PASSWORD (delete it to reset).
# Shared: models/, custom_nodes/, --user-directory (workflows + settings).
# Separate: output/input/temp (isolates assets from the open instance).
ExecStart=/srv/ai/venvs/comfyui/bin/python /srv/ai/comfyui/main.py \
  --listen 0.0.0.0 --port 8189 \
  --extra-model-paths-config /srv/ai/scripts/comfyui-secure-extra-paths.yaml \
  --output-directory /srv/ai/comfyui/output-secure \
  --input-directory /srv/ai/comfyui/input-secure \
  --temp-directory /srv/ai/comfyui/temp-secure \
  --user-directory /srv/ai/comfyui/user \
  --database-url sqlite:////srv/ai/comfyui/user/comfyui-secure.db \
  --preview-method auto $COMFYUI_EXTRA_ARGS
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
KillMode=mixed

[Install]
WantedBy=multi-user.target
